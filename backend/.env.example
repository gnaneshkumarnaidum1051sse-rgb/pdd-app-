# Firebase Admin credentials: obtain these from Firebase Console > Project settings > Service accounts.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-this-value\n-----END PRIVATE KEY-----\n"

# The frontend origin during development.
CLIENT_ORIGIN=http://localhost:8080
PORT=3001
